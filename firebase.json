{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "predeploy": ["npm run build"]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "firebase-dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/",
        "destination": "/clients/newphase-coaching/",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/clients/newphase-coaching/**",
        "destination": "/clients/newphase-coaching/index.html"
      }
    ]
  }
}
