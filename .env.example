# NewPhase Coaching — environment configuration

# API base URL for the Tame Dynamics backend
NEXT_PUBLIC_API_URL=https://api.tame-dynamics.com/api/v1

# Base path the site is served under (empty = domain root, newphase-coaching.com)
NEXT_PUBLIC_BASE_PATH=

# Set to "true" only for static export builds (build:static handles this)
# NP_STATIC_EXPORT=true
